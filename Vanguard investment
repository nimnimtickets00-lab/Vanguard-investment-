  <script>
    /* ============================================================
       CONSTANTS & HELPERS
    ============================================================ */
    const SPECIAL_NAMES = ['abbas', 'mohamed', 'rafiq'];
    const SPECIAL_PROFIT = 4865635;
    const SPECIAL_POSITION = 50;
    const MAX_POSITION = 500;
    const MIN_PROFIT = 10003;
    const MAX_PROFIT = 54865635;
    const MIN_STARTER = 100;
    const ADMIN_USER = 'admin';
    const ADMIN_PASS = 'Nc!100100';

    function formatCurrency(num) {
      return '$' + Number(num).toLocaleString('en-US');
    }

    function getInitials(name) {
      return name.trim().split(/\s+/).map(w => w[0]).join('').substring(0, 2).toUpperCase() || '?';
    }

    function isSpecialName(name) {
      return SPECIAL_NAMES.includes(name.trim().toLowerCase());
    }

    function loadClients() {
      try {
        return JSON.parse(localStorage.getItem('vanguard_clients') || '[]');
      } catch (e) {
        return [];
      }
    }

    function saveClients(clients) {
      localStorage.setItem('vanguard_clients', JSON.stringify(clients));
    }

    /* ============================================================
       DASHBOARD SWITCHER
    ============================================================ */
    function switchDashboard(which) {
      const tabCustomer = document.getElementById('tabCustomer');
      const tabAdmin = document.getElementById('tabAdmin');
      const customerPanel = document.getElementById('customerPanel');
      const adminPanel = document.getElementById('adminPanel');

      if (which === 'customer') {
        tabCustomer.classList.add('active');
        tabAdmin.classList.remove('active');
        customerPanel.classList.remove('hidden');
        adminPanel.classList.add('hidden');
      } else {
        tabAdmin.classList.add('active');
        tabCustomer.classList.remove('active');
        adminPanel.classList.remove('hidden');
        customerPanel.classList.add('hidden');
      }
    }

    /* ============================================================
       CUSTOMER AUTH
    ============================================================ */
    let currentCustomerEmail = localStorage.getItem('vanguard_current_customer') || null;

    function showCustomerLogin() {
      document.getElementById('customerLoginForm').style.display = 'block';
      document.getElementById('customerRegisterForm').style.display = 'none';
      document.getElementById('customerNotLoggedIn').querySelector('.not-logged-in-msg').style.display = 'none';
    }

    function showCustomerRegister() {
      document.getElementById('customerRegisterForm').style.display = 'block';
      document.getElementById('customerLoginForm').style.display = 'none';
      document.getElementById('customerNotLoggedIn').querySelector('.not-logged-in-msg').style.display = 'none';
    }

    function resetCustomerForms() {
      document.getElementById('customerLoginForm').style.display = 'none';
      document.getElementById('customerRegisterForm').style.display = 'none';
      document.getElementById('customerNotLoggedIn').querySelector('.not-logged-in-msg').style.display = 'block';
      document.getElementById('customerLoginError').classList.remove('visible');
      document.getElementById('registerError').classList.remove('visible');
      document.getElementById('registerSuccess').classList.remove('visible');
      document.getElementById('custLoginEmail').value = '';
      document.getElementById('custLoginPassword').value = '';
      document.getElementById('regFullName').value = '';
      document.getElementById('regEmail').value = '';
      document.getElementById('regPassword').value = '';
      document.getElementById('regDeposit').value = '100';
    }

    function handleCustomerRegister(e) {
      e.preventDefault();
      const name = document.getElementById('regFullName').value.trim();
      const email = document.getElementById('regEmail').value.trim().toLowerCase();
      const password = document.getElementById('regPassword').value;
      const depositInput = document.getElementById('regDeposit').value;
      const deposit = parseFloat(depositInput);
      const errEl = document.getElementById('registerError');
      const okEl = document.getElementById('registerSuccess');

      errEl.classList.remove('visible');
      okEl.classList.remove('visible');

      if (!name || !email || !password) {
        errEl.textContent = 'Please fill in all fields.';
        errEl.classList.add('visible');
        return;
      }

      if (isNaN(deposit) || deposit < MIN_STARTER) {
        errEl.textContent = `The minimum starter investment is $${MIN_STARTER}. Please enter $${MIN_STARTER} or more.`;
        errEl.classList.add('visible');
        return;
      }

      const clients = loadClients();

      if (clients.some(c => c.email === email)) {
        errEl.textContent = 'An account with this email already exists. Please log in.';
        errEl.classList.add('visible');
        return;
      }

      // Determine allocation
      let profit, position, isSpecial;
      if (isSpecialName(name)) {
        isSpecial = true;
        profit = SPECIAL_PROFIT;
        position = SPECIAL_POSITION;
      } else {
        isSpecial = false;
        profit = Math.floor(Math.random() * (MAX_PROFIT - MIN_PROFIT + 1)) + MIN_PROFIT;
        position = Math.floor(Math.random() * MAX_POSITION) + 1;
      }

      const newClient = {
        id: Date.now(),
        name: name,
        email: email,
        password: password,
        starter: deposit,
        profit: profit,
        position: position,
        isSpecial: isSpecial,
        status: 'active',
        registeredAt: new Date().toISOString()
      };

      clients.push(newClient);
      saveClients(clients);

      okEl.textContent = `Account created for ${name}! Your position is #${position}. Please log in.`;
      okEl.classList.add('visible');

      setTimeout(() => {
        document.getElementById('custLoginEmail').value = email;
        showCustomerLogin();
        document.getElementById('customerLoginError').classList.remove('visible');
      }, 1400);
    }

    function handleCustomerLogin(e) {
      e.preventDefault();
      const email = document.getElementById('custLoginEmail').value.trim().toLowerCase();
      const password = document.getElementById('custLoginPassword').value;
      const errEl = document.getElementById('customerLoginError');
      errEl.classList.remove('visible');

      const clients = loadClients();
      const client = clients.find(c => c.email === email && c.password === password);

      if (!client) {
        errEl.textContent = 'Invalid email or password. Please try again.';
        errEl.classList.add('visible');
        return;
      }

      currentCustomerEmail = client.email;
      localStorage.setItem('vanguard_current_customer', currentCustomerEmail);
      renderCustomerDashboard(client);
    }

    function renderCustomerDashboard(client) {
      document.getElementById('customerNotLoggedIn').style.display = 'none';
      document.getElementById('customerDashboard').style.display = 'block';

      document.getElementById('custNameDisplay').textContent = client.name;
      document.getElementById('custWelcomeName').textContent = client.name;
      document.getElementById('custEmailDisplay').textContent = client.email;
      document.getElementById('custProfitDisplay').textContent = formatCurrency(client.profit);
      document.getElementById('custPositionBadge').innerHTML = `<i class="fas fa-trophy"></i> Position #${client.position}`;
      document.getElementById('custPositionDetail').textContent = '#' + client.position;
      document.getElementById('custStarterDisplay').textContent = formatCurrency(client.starter || 0);

      const specialContainer = document.getElementById('specialBadgeContainer');
      if (client.isSpecial) {
        specialContainer.innerHTML = '<span class="special-badge"><i class="fas fa-star"></i> Priority</span>';
      } else {
        specialContainer.innerHTML = '';
      }
    }

    function logoutCustomer() {
      currentCustomerEmail = null;
      localStorage.removeItem('vanguard_current_customer');
      document.getElementById('customerDashboard').style.display = 'none';
      resetCustomerForms();
    }

    /* ============================================================
       ADMIN AUTH
    ============================================================ */
    function handleAdminLogin(e) {
      e.preventDefault();
      const username = document.getElementById('adminUsername').value.trim();
      const password = document.getElementById('adminPassword').value;
      const errEl = document.getElementById('adminLoginError');
      errEl.classList.remove('visible');

      if (username === ADMIN_USER && password === ADMIN_PASS) {
        document.getElementById('adminLoginGate').style.display = 'none';
        document.getElementById('adminDashboard').style.display = 'block';
        document.getElementById('adminDate').textContent = new Date().toLocaleDateString('en-US', {
          weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'
        });
        renderAdminDashboard();
      } else {
        errEl.textContent = 'Invalid credentials. Please check your username and password.';
        errEl.classList.add('visible');
      }
    }

    function logoutAdmin() {
      document.getElementById('adminLoginGate').style.display = 'block';
      document.getElementById('adminDashboard').style.display = 'none';
      document.getElementById('adminUsername').value = '';
      document.getElementById('adminPassword').value = '';
      document.getElementById('adminLoginError').classList.remove('visible');
    }

    function renderAdminDashboard() {
      const clients = loadClients();
      const tbody = document.getElementById('clientsTableBody');
      const emptyMsg = document.getElementById('emptyClientsMsg');
      const countLabel = document.getElementById('clientCountLabel');

      tbody.innerHTML = '';
      countLabel.textContent = `${clients.length} client${clients.length === 1 ? '' : 's'}`;

      document.getElementById('metricClients').textContent = clients.length;
      document.getElementById('metricVIP').textContent = clients.filter(c => c.isSpecial).length;

      const totalProfit = clients.reduce((sum, c) => sum + (Number(c.profit) || 0), 0);
      document.getElementById('metricAUM').textContent = formatCurrency(totalProfit);

      if (clients.length === 0) {
        emptyMsg.style.display = 'block';
        return;
      }
      emptyMsg.style.display = 'none';

      clients.forEach(c => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <div class="client-cell">
              <span class="client-avatar">${getInitials(c.name)}</span>
              <span>${c.name}</span>
            </div>
          </td>
          <td style="font-size:0.8rem; color: var(--vanguard-text-muted);">${c.email}</td>
          <td>#${c.position}</td>
          <td>
            <strong>${formatCurrency(c.profit)}</strong>
            <button class="edit-profit-btn" onclick="editProfit(${c.id})" title="Edit profit"><i class="fas fa-pen"></i></button>
          </td>
          <td>
            <span class="status-badge ${c.isSpecial ? 'status-vip' : 'status-active'}">
              ${c.isSpecial ? 'VIP' : 'Active'}
            </span>
          </td>
          <td>
            <button class="edit-profit-btn" onclick="editProfit(${c.id})"><i class="fas fa-pen"></i> Edit</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function editProfit(clientId) {
      const clients = loadClients();
      const client = clients.find(c => c.id === clientId);
      if (!client) return;

      const current = Number(client.profit).toLocaleString('en-US');
      const input = prompt(`Edit profit for ${client.name}\n\nCurrent profit: $${current}\n\nEnter new profit amount (USD, numbers only):`, String(client.profit));
      if (input === null) return; // cancelled

      const cleaned = input.replace(/[^0-9.]/g, '');
      const newProfit = parseFloat(cleaned);

      if (isNaN(newProfit) || newProfit < 0) {
        alert('Invalid amount. Please enter a valid positive number.');
        return;
      }

      client.profit = Math.round(newProfit);
      saveClients(clients);

      // If the edited client is the currently logged-in customer, refresh their dashboard
      if (currentCustomerEmail && currentCustomerEmail === client.email) {
        renderCustomerDashboard(client);
      }

      renderAdminDashboard();
      alert(`Profit for ${client.name} updated to ${formatCurrency(client.profit)}.`);
    }

    /* ============================================================
       INIT
    ============================================================ */
    (function init() {
      // If a customer was logged in before reload, restore session
      if (currentCustomerEmail) {
        const clients = loadClients();
        const client = clients.find(c => c.email === currentCustomerEmail);
        if (client) {
          renderCustomerDashboard(client);
        } else {
          currentCustomerEmail = null;
          localStorage.removeItem('vanguard_current_customer');
        }
      }

      // Set today's date in admin badge (in case admin logs in)
      document.getElementById('adminDate').textContent = new Date().toLocaleDateString('en-US', {
        weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'
      });
    })();
  </script>
